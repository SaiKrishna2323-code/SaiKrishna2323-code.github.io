<style>
:root{--navy:#071a35;--blue:#0d5bd7;--sky:#eaf3ff;--gold:#f4b942;--ink:#142033;--muted:#60708a;--white:#fff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);background:#f7f9fc;line-height:1.65}
nav{position:sticky;top:0;z-index:10;background:rgba(7,26,53,.94);backdrop-filter:blur(12px);color:white;padding:14px 6%;display:flex;align-items:center;justify-content:space-between}
.logo{font-weight:800;letter-spacing:.4px}.logo span{color:var(--gold)}
nav a{color:#fff;text-decoration:none;margin-left:24px;font-size:.93rem}
.hero {
  min-height:78vh;
  display:grid;
  place-items:center;
  text-align:center;
  padding:90px 6%;
  background:
    linear-gradient(rgba(7,26,53,.66),rgba(7,26,53,.78)),
    url("data:image/png;base64,") center/cover no-repeat;
  color:#fff;
  position:relative;
  overflow:hidden;
}
.hero:after{content:"";position:absolute;width:420px;height:420px;border:70px solid rgba(255,255,255,.06);border-radius:50%;right:-120px;top:-120px}
.badge{display:inline-block;padding:7px 14px;border:1px solid rgba(255,255,255,.35);border-radius:999px;background:rgba(255,255,255,.08);font-size:.9rem}
h1{font-size:clamp(2.5rem,7vw,5.5rem);line-height:1.02;margin:18px 0 20px;max-width:900px}
.hero p{max-width:720px;margin:auto;color:#dce9ff;font-size:1.12rem}
.btn{display:inline-block;margin-top:28px;background:var(--gold);color:#162033;padding:12px 20px;border-radius:10px;text-decoration:none;font-weight:800}
section{padding:80px 6%;max-width:1200px;margin:auto}.eyebrow{color:var(--blue);font-weight:800;text-transform:uppercase;letter-spacing:1.5px;font-size:.78rem}
h2{font-size:2.3rem;margin:8px 0 12px}.intro{max-width:720px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:35px}
.card{background:white;border:1px solid #e5eaf2;border-radius:18px;padding:25px;box-shadow:0 10px 30px rgba(12,32,65,.06)}
.icon{font-size:2rem}.card h3{margin:10px 0 5px}.card p{color:var(--muted);margin:0}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:35px}.stat{background:var(--navy);color:white;border-radius:16px;padding:25px}.stat b{font-size:1.7rem;display:block;color:var(--gold)}
.feature{background:linear-gradient(135deg,#edf5ff,#fff);border-radius:28px;padding:45px;display:grid;grid-template-columns:1.2fr .8fr;gap:35px;align-items:center}
.quote{font-size:1.25rem;font-weight:700}.timeline{border-left:3px solid #b9d4ff;padding-left:22px}.timeline div{margin:0 0 20px}.timeline b{color:var(--blue)}
footer{background:var(--navy);color:#dce9ff;padding:45px 6%;text-align:center}footer strong{color:#fff}
@media(max-width:800px){nav a{display:none}.grid,.stats,.feature{grid-template-columns:1fr}.hero{min-height:70vh}section{padding:60px 5%}}

 {
  .college-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .author-card { align-items: flex-start; flex-direction: column; }
  .college-grid { grid-template-columns: 1fr; }
}


.author-card {
  max-width: 1100px;
  margin: 30px auto 10px;
  padding: 24px 28px;
  border: 1px solid rgba(15, 23, 42, .10);
  border-radius: 20px;
  background: linear-gradient(135deg, #ffffff, #f7f9fc);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 28px;
  box-shadow: 0 12px 35px rgba(15, 23, 42, .07);
}
.author-info h2 { margin: 5px 0 6px; }
.author-info p { margin: 4px 0; line-height: 1.55; }
.author-course { font-size: 1.02rem; }
.author-handle { font-weight: 700; margin-top: 10px !important; }
.qr-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
  text-align: center;
  font-size: .78rem;
  line-height: 1.35;
}
.qr-wrap img {
  width: 105px;
  height: 105px;
  padding: 7px;
  background: #fff;
  border-radius: 12px;
  border: 1px solid rgba(15, 23, 42, .10);
}


#about-me{padding-top:30px}
#about-me .eyebrow{margin-bottom:4px}

#gallery{padding-top:55px}
.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:35px}
.photo-card{margin:0;background:#fff;border:1px solid #e5eaf2;border-radius:18px;overflow:hidden;box-shadow:0 10px 30px rgba(12,32,65,.08)}
.photo-card img{display:block;width:100%;height:245px;object-fit:cover}
.photo-card figcaption{padding:18px 20px;color:var(--muted);line-height:1.5}
.photo-card figcaption strong{color:var(--ink);font-size:1.05rem}
@media(max-width:800px){.photo-grid{grid-template-columns:1fr}.photo-card img{height:220px}}
</style>
</head>
